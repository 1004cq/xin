XIN_BASE_URL=https://xin.duojiayi.com
XIN_SESSION_SECRET=replace-with-generated-secret
XIN_ADMIN_HASH=replace-with-generated-hash

# Optional, private synced Bitcoin Core mainnet RPC. Do not expose to internet.
# XIN_BITCOIN_RPC_URL=http://private-node:8332/
# XIN_BITCOIN_RPC_USER=
# XIN_BITCOIN_RPC_PASSWORD=

# Required: 32 random bytes, hex; generated by setup_env.py. Never use placeholders.
XIN_DATA_KEY=replace-with-generated-key
XIN_ADMIN_ENROLL_TOKEN=replace-with-generated-token

# Optional public digest + OTS verification using operator's node, disabled by default.
XIN_PUBLIC_NODE_VERIFY=0
